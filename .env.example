# ---------------------------------------------------------------------------
# Echelons Call Recording Platform — environment template.
# Copy to /etc/echelons/echelons.env (production) or .env (development).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Branding (white-label)
PRODUCT_NAME="Echelons Call Recording Platform"
PRODUCT_SHORT_NAME="Echelons"

# PostgreSQL — application schema "app", Asterisk realtime schema "asterisk"
DATABASE_URL="postgresql://echelons:CHANGE_ME@127.0.0.1:5432/echelons?schema=app"

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
PUBLIC_BASE_URL=https://recording.example.com
JWT_SECRET=CHANGE_ME_64_RANDOM_BYTES_BASE64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32-byte key, base64. Used for AES-256-GCM encryption of SIP/S3 secrets at rest.
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# Asterisk connector (backend -> connector, mutual shared-secret auth)
CONNECTOR_URL=http://127.0.0.1:4100
CONNECTOR_TOKEN=CHANGE_ME_RANDOM

# Asterisk (used by the connector only — never by the frontend)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=echelons
ASTERISK_AMI_PASSWORD=CHANGE_ME
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=echelons
ASTERISK_ARI_PASSWORD=CHANGE_ME
ASTERISK_CONFIG_DIR=/etc/asterisk

# Recording storage
RECORDING_BASE_PATH=/var/spool/asterisk/recording
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis (BullMQ background jobs)
REDIS_URL=redis://127.0.0.1:6379

LOG_LEVEL=info

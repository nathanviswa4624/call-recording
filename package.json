{
  "name": "echelons-call-recording-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Echelons Call Recording Platform — call recording, SIP trunk, Asterisk (PJSIP/Sorcery) management and CDR analytics",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:backend": "pnpm --filter @echelons/backend dev",
    "dev:connector": "pnpm --filter @echelons/connector dev",
    "dev:web": "pnpm --filter @echelons/web dev",
    "db:generate": "pnpm --filter @echelons/backend prisma:generate",
    "db:migrate": "pnpm --filter @echelons/backend prisma:migrate"
  }
}
